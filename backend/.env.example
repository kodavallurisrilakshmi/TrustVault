# TrustVault Environment Configuration Template
# SECURITY: Never commit actual secrets or production credentials to version control.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Security & Cryptography
# Generate a cryptographically random secret in production (e.g., openssl rand -hex 32)
SECRET_KEY=change-this-in-production-use-a-cryptographically-random-key-of-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connections (Separated Roles)
# 1. trustvault_admin: DDL owner, executes migrations, owns schemas/tables
DATABASE_ADMIN_URL=postgresql+asyncpg://trustvault_admin:admin_password_change_me@localhost:5432/trustvault
DATABASE_ADMIN_SYNC_URL=postgresql+psycopg://trustvault_admin:admin_password_change_me@localhost:5432/trustvault

# 2. trustvault_app: Least-privilege runtime role (DML only, NO ALTER/DROP, NO UPDATE/DELETE on audit_logs)
DATABASE_APP_URL=postgresql+asyncpg://trustvault_app:app_password_change_me@localhost:5432/trustvault
DATABASE_APP_SYNC_URL=postgresql+psycopg://trustvault_app:app_password_change_me@localhost:5432/trustvault

# Test Database Connections (Isolated)
TEST_DATABASE_URL=postgresql+asyncpg://trustvault_app:app_password_change_me@localhost:5432/trustvault_test
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://trustvault_admin:admin_password_change_me@localhost:5432/trustvault_test

# Private Storage Vault Configuration
# Must reside OUTSIDE any publicly routed directory
STORAGE_VAULT_PATH=./storage_vault
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_EXTENSIONS=pdf,docx,xlsx,png,jpg,txt,csv
